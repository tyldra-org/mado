{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mado",
  "version": "0.0.0",
  "identifier": "app.mado",
  "build": {
    "frontendDist": "resources/ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
